# NFX-Vault Docker Compose Environment Variables
# Go TLS/file/analysis/system + Identity login. Python backend is not the runtime.
# HTTP 入口只有 NFX-Edge；本栈不跑 Traefik。

TRAEFIK_API_HOST=vault-api.example.com
TRAEFIK_CONSOLE_HOST=vault.example.com

HTTP_PORT=8080
CONSOLE_PORT=80
CONSOLE_EXTERNAL_PORT=10224
VITE_PORT=5175
VITE_API_URL=https://vault-api.example.com
VITE_IDENTITY_API_URL=https://api.example.com

# Identity auth gRPC (NFX-Identity)
# 容器内 GRPC_PORT_*（50071+）；主机 GRPC_EXT_*。compose: "${GRPC_EXT_PORT_*}:${GRPC_PORT_*}"
GRPC_PORT_AUTH=50071
GRPC_PORT_TLS=50072
GRPC_PORT_FILE=50073
GRPC_PORT_ANALYSIS=50074
GRPC_PORT_SYSTEM=50075
GRPC_PORT_DNS=50076

GRPC_EXT_PORT_TLS=10219
GRPC_EXT_PORT_FILE=10220
GRPC_EXT_PORT_ANALYSIS=10221
GRPC_EXT_PORT_SYSTEM=10222
GRPC_EXT_PORT_DNS=10223

GRPC_HOST_AUTH=NFX-Identity-Auth-Base-Dev
GRPC_HOST_TLS=tls-base
GRPC_HOST_FILE=file-base
GRPC_HOST_ANALYSIS=analysis-base
GRPC_HOST_SYSTEM=system-base
GRPC_HOST_DNS=dns-base

API_PREFIX_PATH_TLS=/vault/tls
API_PREFIX_PATH_FILE=/vault/file
API_PREFIX_PATH_ANALYSIS=/vault/analysis
API_PREFIX_PATH_SYSTEM=/system
API_PREFIX_PATH_DNS=/vault/dns

POSTGRESQL_HOST=172.18.0.6
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your-postgresql-password-here
POSTGRESQL_NAME_DEV=nfxvault_dev
POSTGRESQL_NAME_PROD=nfxvault
POSTGRESQL_NAME_SHADOW=nfxvault_diff
ATLAS_POSTGRES_HOST=192.168.1.64
ATLAS_POSTGRES_PORT=10105
POSTGRES_SSLMODE=disable
POSTGRES_CONTAINER_NAME=NFX-Stack-PostgreSQL

REDIS_HOST=192.168.1.64
REDIS_PORT=10181
REDIS_PASSWORD=your-redis-password-here

KAFKA_HOST=192.168.1.64
KAFKA_PORT=10183
KAFKA_BROKERS=192.168.1.64:10183

OTEL_EXPORTER_OTLP_ENDPOINT=192.168.1.64:10192

# Must match NFX-Identity TOKEN_SECRET_KEY / TOKEN_ISSUER
TOKEN_SECRET_KEY=your-secret-key-here-change-in-production
TOKEN_ISSUER=nfxidentity
TOKEN_ACCESS_TTL=24h
TOKEN_REFRESH_TTL=168h
TOKEN_ALGORITHM=HS256

# CERTS_DIR is the Vault repo root; file export writes $CERTS_DIR/Websites/{folder}/cert.crt
# NFX-Edge docker-compose mounts that Websites dir as /certs/websites (see Edge tls.yaml lucaslyu).
CERTS_DIR=/your-repo-location/NFX-Vault
ACME_CHALLENGE_DIR=/tmp/acme-challenges
